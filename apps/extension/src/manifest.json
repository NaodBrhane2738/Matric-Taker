{
  "manifest_version": 3,
  "name": "Matric Tracker — Focus Blocker",
  "version": "1.0.0",
  "description": "Distraction-free website blocker for Ethiopian Matric examination preparation",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Matric Tracker Blocker"
  },
  "background": {
    "service_worker": "background.js"
  }
}

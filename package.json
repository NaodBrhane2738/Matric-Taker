{
  "name": "matric-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Comprehensive Ethiopian Grade 12 National Examination preparation and study management platform",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter \"@matric/*\" build && pnpm --filter web build",
    "test": "pnpm --filter \"@matric/*\" test",
    "db:generate": "pnpm --filter @matric/database db:generate",
    "db:migrate": "pnpm --filter @matric/database db:migrate",
    "db:push": "pnpm --filter @matric/database db:push",
    "db:studio": "pnpm --filter @matric/database db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}

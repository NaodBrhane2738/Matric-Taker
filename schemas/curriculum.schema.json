{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://matrictracker.edu/schemas/v1/curriculum.schema.json",
  "title": "Ethiopian Secondary Curriculum Schema",
  "description": "Standardized schema for Grade 9-12 Ethiopian national examination curriculum hierarchy and source references",
  "type": "object",
  "required": ["schema_version", "curriculum"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "curriculum": {
      "type": "object",
      "required": ["id", "name", "country_code", "language", "source_documents", "grades"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "country_code": {
          "type": "string",
          "enum": ["ET"]
        },
        "language": {
          "type": "string",
          "enum": ["en", "am"]
        },
        "source_documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_document"
          }
        },
        "grades": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/grade"
          }
        }
      }
    }
  },
  "definitions": {
    "source_document": {
      "type": "object",
      "required": ["id", "filename", "grade", "subject_id", "document_type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "integer",
          "minimum": 9,
          "maximum": 12
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "document_type": {
          "type": "string",
          "enum": ["textbook", "syllabus", "curriculum_guide", "other"]
        }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["document_id", "pdf_page_start", "pdf_page_end"],
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "pdf_page_start": {
          "type": "integer",
          "minimum": 1
        },
        "pdf_page_end": {
          "type": "integer",
          "minimum": 1
        },
        "printed_page_label": {
          "type": "string"
        }
      }
    },
    "grade": {
      "type": "object",
      "required": ["grade", "subjects"],
      "additionalProperties": false,
      "properties": {
        "grade": {
          "type": "integer",
          "minimum": 9,
          "maximum": 12
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subject"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "name", "order", "review_status", "units"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g(09|10|11|12)-[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "review_status": {
          "type": "string",
          "enum": ["verified", "needs_review"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_ref"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unit"
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "number", "title", "order", "review_status", "chapters"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g(09|10|11|12)-[a-z0-9_-]+-u[0-9]{2,}$"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "review_status": {
          "type": "string",
          "enum": ["verified", "needs_review"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_ref"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/chapter"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "number", "title", "order", "review_status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g(09|10|11|12)-[a-z0-9_-]+-u[0-9]{2,}-c[0-9]{2,}$"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "review_status": {
          "type": "string",
          "enum": ["verified", "needs_review"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_ref"
          }
        },
        "prerequisite_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtopics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subtopic"
          }
        }
      }
    },
    "subtopic": {
      "type": "object",
      "required": ["id", "number", "title", "order", "review_status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g(09|10|11|12)-[a-z0-9_-]+-u[0-9]{2,}-c[0-9]{2,}-s[0-9]{2,}$"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "review_status": {
          "type": "string",
          "enum": ["verified", "needs_review"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_ref"
          }
        }
      }
    }
  }
}
